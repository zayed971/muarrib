# --- Provider keys (at least one required) ---
# Anthropic is the default server-side provider (lib/config.ts).
ANTHROPIC_API_KEY=
# Gemini is the free-tier BYOK option offered to users in the UI.
GEMINI_API_KEY=

# --- Cloudflare Turnstile (bot gate before any paid translation call) ---
# Get a free widget (site key + secret key) at https://dash.cloudflare.com/ -> Turnstile.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Upstash Redis (optional) ---
# If unset, cache/rate-limit/metrics fall back to an in-memory store — fine for
# local dev, NOT safe for a multi-instance production deploy (each serverless
# instance would get its own counters).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional tuning (all have defaults in code, only set to override) ---
# IP_BURST_PER_MIN=20
# GLOBAL_DAILY_PAGES=5000
# CACHE_TTL_SECONDS=2592000
# ADMIN_TOKEN=            # protects GET /api/metrics
